{
  "name": "paypal-agent-trust",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "catalog": "node --env-file=.env.local scripts/build-catalog.mts",
    "check-schema": "node scripts/check-schema.mts",
    "check-search": "node --env-file=.env.local scripts/check-search.mts",
    "test": "node --test tests/*.test.mts",
    "fixtures": "node --env-file=.env.local scripts/run-fixtures.mts",
    "eval-checker": "node --env-file=.env.local scripts/eval-checker.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
