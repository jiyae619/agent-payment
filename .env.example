# PayPal sandbox app credentials: developer.paypal.com → Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional; defaults to sandbox
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Channel3 product search: trychannel3.com/developers (promo code PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=

# Claude (drafts the instructions): console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# Seals the shopper's approval so it can't be changed afterwards. Any random string of 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APPROVAL_SECRET=

# Public demo (option A): the sandbox PayPal account visitors shop with. Save one on /day1
# ("Save PayPal account"), then paste the vault id it shows here.
PAYPAL_DEMO_VAULT_ID=
